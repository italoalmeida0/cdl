{
  "name": "cdl",
  "version": "1.0.0",
  "description": "CDL (Content Delivery Link) — self-hosted single-admin temporary direct download link service.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch server/index.ts",
    "dev:web": "bun ./dev-web.ts 5700",
    "start": "bun server/index.ts",
    "build": "NODE_ENV=production bun ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test DATA_DIR=./data/test bun test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.157",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "babel-preset-solid": "^1.9.19",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
